[Unit]
Description=Deploy Go Agent Runner Broker
After=network.target
Before=deploy-go-agent.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/deploy-go-agent/config
ExecStart=/usr/local/bin/deploy-go-agent runner-service
Restart=always
RestartSec=3s
RuntimeDirectory=deploy-go-agent-runner
RuntimeDirectoryMode=0755
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
