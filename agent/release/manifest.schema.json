{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deploy-go.invalid/schemas/agent-release-manifest.schema.json",
  "title": "Deploy Go Agent paired release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_version",
    "executor_version",
    "protocol",
    "systemd_units",
    "executor_config",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "agent_version": { "$ref": "#/$defs/version" },
    "executor_version": { "$ref": "#/$defs/version" },
    "runner_protocol": { "const": 1 },
    "executor_protocol": { "enum": [2, 3] },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 1 },
        "maximum": { "type": "integer", "minimum": 1 }
      }
    },
    "systemd_units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "runner", "executor"],
      "properties": {
        "agent": { "$ref": "#/$defs/download" },
        "runner": { "$ref": "#/$defs/download" },
        "executor": { "$ref": "#/$defs/download" }
      }
    },
    "executor_config": { "$ref": "#/$defs/download" },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "os", "architecture", "url", "sha256"],
        "properties": {
          "component": { "enum": ["agent", "executor"] },
          "os": { "const": "linux" },
          "architecture": { "enum": ["x86_64", "aarch64"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
