{
  "name": "deploy-go-ui-preview",
  "private": true,
  "workspaces": [
    "admin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api:client:generate": "node scripts/generate-api-clients.mjs",
