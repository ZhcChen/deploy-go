{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deploy-go.local/schemas/deploy-event-marker-v1.json",
  "title": "Deploy Go Script Event Marker v1",
  "$comment": "业务脚本在 DEPLOY_GO_EVENT 前缀后输出的最小事件标记。运行上下文字段由 Agent 补充。",
  "type": "object",
  "required": [
    "schema_version",
    "event"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event": {
      "enum": [
        "deploy.preflight.started",
        "deploy.preflight.succeeded",
        "deploy.preflight.failed",
        "deploy.module.started",
        "deploy.module.succeeded",
        "deploy.module.failed",
        "deploy.step.started",
        "deploy.step.succeeded",
        "deploy.step.failed",
        "deploy.verification.started",
        "deploy.verification.succeeded",
        "deploy.verification.failed"
      ]
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "module_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "message": {
      "type": "string",
      "maxLength": 8192
    },
    "failure_stage": {
      "type": "string",
      "maxLength": 128
    },
    "recovery_hint": {
      "type": "string",
      "maxLength": 4096
    },
    "candidate_release": {
      "type": "string",
      "maxLength": 256
    },
    "current_release": {
      "type": "string",
      "maxLength": 256
    },
    "current_switched": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "deploy.module.started",
              "deploy.module.succeeded",
              "deploy.module.failed"
            ]
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "module"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "enum": [
              "deploy.step.started",
              "deploy.step.succeeded",
              "deploy.step.failed"
            ]
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "required": [
          "module",
          "step_id",
          "step"
        ]
      }
    }
  ],
  "not": {
    "anyOf": [
      {
        "required": ["deploy_id"]
      },
      {
        "required": ["timestamp"]
      },
      {
        "required": ["status"]
      },
      {
        "required": ["duration_ms"]
      },
      {
        "required": ["exit_code"]
      },
      {
        "required": ["environment"]
      },
      {
        "required": ["release_version"]
      },
      {
        "required": ["target"]
      }
    ]
  },
  "additionalProperties": true
}
