{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deploy-go.local/schemas/deploy-artifact-manifest-v1.json",
  "title": "Deploy Go Artifact Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "release_version",
    "commit_sha",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "module",
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
