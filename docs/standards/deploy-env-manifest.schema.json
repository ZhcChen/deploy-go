{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deploy-go.local/schemas/deploy-env-manifest-v1.json",
  "title": "Deploy Go Env Manifest v1",
  "type": "object",
  "required": ["schema_version", "commit_sha", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "files": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["file_name", "module", "sha256", "size", "format"],
        "properties": {
          "file_name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.env$"
          },
          "module": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "format": { "const": "dotenv-v1" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
