# 复制为仓库根目录 .env 后按需覆盖；不要提交真实密钥。
DEPLOY_HOST=qfy-test
DEPLOY_SOURCE=build

# 使用 GitHub Release 时：
# DEPLOY_SOURCE=release
# DEPLOY_RELEASE_TAG=v0.1.0
# DEPLOY_AGENT_SYNC=1

DEPLOY_API_PORT=30100
DEPLOY_API_BIND=0.0.0.0
DEPLOY_WEB_PORT=30101
DEPLOY_WEB_BIND=0.0.0.0
DEPLOY_GO_COOKIE_SECURE=false
DEPLOY_GO_MASTER_KEY_VERSION=1

# 可选：配置后 API 才会生成 Agent 安装命令，且必须为 HTTPS origin。
# DEPLOY_GO_PUBLIC_BASE_URL=https://deploy-go.example.com

# 可选：默认从 ssh config 的 qfy-test hostname 推断。
# DEPLOY_GO_ALLOWED_ORIGIN=http://114.55.145.81:30101
