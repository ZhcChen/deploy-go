# 复制为仓库根目录 .env 后按需覆盖；不要提交真实密钥。
DEPLOY_HOST=qfy-test
DEPLOY_SOURCE=build

# 默认 1：部署脚本会在本机编译 Agent（x86_64 + aarch64）并上传到服务器。
# 设为 0 可跳过 Agent 构建上传。
DEPLOY_AGENT_SYNC=1

# 使用 GitHub Release 获取 API/Web 产物时（Agent 仍由本机构建）：
# DEPLOY_SOURCE=release
# DEPLOY_RELEASE_TAG=v0.1.0

DEPLOY_API_PORT=30100
DEPLOY_API_BIND=127.0.0.1
DEPLOY_WEB_PORT=30101
DEPLOY_WEB_BIND=127.0.0.1
DEPLOY_GO_COOKIE_SECURE=true
DEPLOY_GO_MASTER_KEY_VERSION=1

DEPLOY_GO_PUBLIC_BASE_URL=https://deploy.quanxinfu.com

DEPLOY_GO_ALLOWED_ORIGIN=https://deploy.quanxinfu.com
