# 复制为仓库根目录 .env 后按需覆盖；不要提交真实密钥。
DEPLOY_HOST=qfy-test
DEPLOY_SOURCE=build

# 特权发布签名密钥由安装器在服务器首次生成（/etc/deploy-go/release-signing.key），
# 与终端签名密钥分离且不通过本文件配置；重复部署只会复用，不会重新生成。

# 默认 1：部署脚本会在本机编译 Agent（x86_64 + aarch64）并上传到服务器。
# 设为 0 可跳过 Agent 构建上传。
DEPLOY_AGENT_SYNC=1

# 只在本机构建 Agent release（x86_64 + aarch64）并校验 manifest，不连接服务器。
# 推荐先执行 make deploy-production-agent-build，再执行 make deploy-production 复用缓存。
# DEPLOY_AGENT_BUILD_ONLY=1
# DEPLOY_AGENT_OUTPUT_DIR=target/deploy-release/agent

# deploy-go-deployer 始终随 API 一起构建并安装，由 API 提供对外下载路径：
# /api/v1/deployer/download/{version}/manifest.json
# /api/v1/deployer/download/{version}/deployer/{x86_64|aarch64}

# 使用 GitHub Release 获取 API/Web 产物时（Agent 仍由本机构建）：
# DEPLOY_SOURCE=release
# DEPLOY_RELEASE_TAG=v0.1.0

DEPLOY_API_PORT=30100
DEPLOY_API_BIND=127.0.0.1
DEPLOY_WEB_PORT=30101
DEPLOY_WEB_BIND=127.0.0.1
DEPLOY_GO_COOKIE_SECURE=true
DEPLOY_GO_MASTER_KEY_VERSION=1

DEPLOY_GO_PUBLIC_BASE_URL=https://deploy.quanxinfu.com

DEPLOY_GO_ALLOWED_ORIGIN=https://deploy.quanxinfu.com

# 跨节点制品通道。正式环境固定使用受 systemd ReadWritePaths 保护的数据目录。
DEPLOY_GO_CROSS_NODE_ARTIFACTS_ENABLED=true
DEPLOY_GO_ARTIFACTS_ROOT=/var/lib/deploy-go/artifacts
DEPLOY_GO_ARTIFACT_MAX_FILE_BYTES=536870912
DEPLOY_GO_ARTIFACT_MAX_TOTAL_BYTES=2147483648
DEPLOY_GO_ARTIFACT_MAX_FILES=256
DEPLOY_GO_ARTIFACT_MAX_CHUNK_BYTES=8388608
DEPLOY_GO_ARTIFACT_UPLOAD_TTL_SECONDS=1800
DEPLOY_GO_ARTIFACT_RETENTION_TTL_SECONDS=86400
