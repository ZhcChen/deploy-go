{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deploy-go.local/schemas/agent-control-v6.json",
  "title": "Deploy Go Agent Control Protocol v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "message_id", "sent_at", "message"],
  "properties": {
    "protocol_version": { "const": 6 },
    "message_id": { "$ref": "#/$defs/id" },
    "sent_at": { "$ref": "#/$defs/timestamp" },
    "message": {
      "oneOf": [
        { "$ref": "#/$defs/hello" },
        { "$ref": "#/$defs/hello_ack" },
        { "$ref": "#/$defs/auth_refresh" },
        { "$ref": "#/$defs/auth_refreshed" },
        { "$ref": "#/$defs/heartbeat" },
        { "$ref": "#/$defs/heartbeat_ack" },
        { "$ref": "#/$defs/task_dispatch" },
        { "$ref": "#/$defs/task_ack" },
        { "$ref": "#/$defs/task_output" },
        { "$ref": "#/$defs/task_progress" },
        { "$ref": "#/$defs/task_state" },
        { "$ref": "#/$defs/task_result" },
        { "$ref": "#/$defs/task_cancel" },
        { "$ref": "#/$defs/reconcile_request" },
        { "$ref": "#/$defs/reconcile_report" },
        { "$ref": "#/$defs/secret_lease_request" },
        { "$ref": "#/$defs/secret_lease_response" },
        { "$ref": "#/$defs/artifact_prepared" },
        { "$ref": "#/$defs/artifact_upload_authorized" },
        { "$ref": "#/$defs/terminal_open" },
        { "$ref": "#/$defs/terminal_opened" },
        { "$ref": "#/$defs/terminal_input" },
        { "$ref": "#/$defs/terminal_output" },
        { "$ref": "#/$defs/terminal_resize" },
        { "$ref": "#/$defs/terminal_close" },
        { "$ref": "#/$defs/terminal_exited" },
        { "$ref": "#/$defs/protocol_error" }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "agent_id", "agent_version", "min_protocol_version", "max_protocol_version", "os", "architecture"],
      "properties": {
        "type": { "const": "hello" },
        "agent_id": { "$ref": "#/$defs/id" },
        "agent_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "min_protocol_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "max_protocol_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "os": { "type": "string", "minLength": 1, "maxLength": 64 },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 64 },
        "capabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "enum": ["pty_terminal"] }
        }
      }
    },
    "hello_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "connection_id", "connection_generation", "protocol_version", "heartbeat_interval_seconds"],
      "properties": {
        "type": { "const": "hello_ack" },
        "connection_id": { "$ref": "#/$defs/id" },
        "connection_generation": { "type": "integer", "minimum": 1 },
        "protocol_version": { "type": "integer", "minimum": 1, "maximum": 6 },
        "heartbeat_interval_seconds": { "type": "integer", "minimum": 5, "maximum": 300 }
      }
    },
    "auth_refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "access_token", "rotation_id"],
      "properties": {
        "type": { "const": "auth_refresh" },
        "access_token": { "type": "string", "minLength": 32, "maxLength": 512 },
        "rotation_id": { "$ref": "#/$defs/id" }
      }
    },
    "auth_refreshed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rotation_id", "access_expires_at"],
      "properties": {
        "type": { "const": "auth_refreshed" },
        "rotation_id": { "$ref": "#/$defs/id" },
        "access_expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "connection_generation", "active_task_ids"],
      "properties": {
        "type": { "const": "heartbeat" },
        "connection_generation": { "type": "integer", "minimum": 1 },
        "active_task_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "heartbeat_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "connection_generation", "server_time"],
      "properties": {
        "type": { "const": "heartbeat_ack" },
        "connection_generation": { "type": "integer", "minimum": 1 },
        "server_time": { "$ref": "#/$defs/timestamp" }
      }
    },
    "task_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "task_id", "idempotency_key", "deadline_at", "payload_digest", "task"],
      "properties": {
        "type": { "const": "task_dispatch" },
        "task_id": { "$ref": "#/$defs/id" },
        "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[ -~]+$" },
        "deadline_at": { "$ref": "#/$defs/timestamp" },
        "payload_digest": { "type": "string", "pattern": "^sha256:[0-9A-Fa-f]+$", "maxLength": 80 },
        "task": {
          "oneOf": [
            { "$ref": "#/$defs/system_inspect_task" },
            { "$ref": "#/$defs/deployment_execute_task" },
            { "$ref": "#/$defs/health_diagnose_task" },
            { "$ref": "#/$defs/git_refs_query_task" },
            { "$ref": "#/$defs/deployment_prepare_task" },
            { "$ref": "#/$defs/deployment_release_task" },
            { "$ref": "#/$defs/env_sync_task" }
          ]
        }
      }
    },
    "system_inspect_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "system_inspect" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["work_root", "secrets_root"],
          "properties": {
            "work_root": { "$ref": "#/$defs/absolute_path" },
            "secrets_root": { "$ref": "#/$defs/absolute_path" }
          }
        }
      }
    },
    "deployment_execute_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "deployment_execute" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deployment_id", "work_root", "script_path", "argument_tokens", "environment_file_references", "timeout_seconds", "wrapper_version"],
          "properties": {
            "deployment_id": { "$ref": "#/$defs/id" },
            "work_root": { "$ref": "#/$defs/absolute_path" },
            "script_path": { "$ref": "#/$defs/absolute_path" },
            "argument_tokens": {
              "type": "array",
              "maxItems": 256,
              "items": { "type": "string", "maxLength": 4096 }
            },
            "environment_file_references": {
              "type": "array",
              "maxItems": 128,
              "items": { "$ref": "#/$defs/environment_file_reference" }
            },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "wrapper_version": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    },
    "environment_file_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_key", "file_path"],
      "properties": {
        "environment_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
        "file_path": { "$ref": "#/$defs/absolute_path" }
      }
    },
    "repository_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!.*://[^/\\s]*@)[^\\s]+$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "module_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "environment": {
      "enum": ["dev", "test", "staging", "prod"]
    },
    "git_refs_query_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "git_refs_query" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["refs_query_id", "repository_url", "git_credential_lease_id", "timeout_seconds"],
          "properties": {
            "refs_query_id": { "$ref": "#/$defs/id" },
            "repository_url": { "$ref": "#/$defs/repository_url" },
            "git_credential_lease_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
          }
        }
      }
    },
    "deployment_prepare_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "deployment_prepare" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deployment_id", "source_policy", "repository_url", "commit_sha", "checkout_dir", "work_root", "output_dir", "environment", "release_version", "modules", "make_target", "git_credential_lease_id", "timeout_seconds"],
          "properties": {
            "deployment_id": { "$ref": "#/$defs/id" },
            "source_policy": { "enum": ["branch"] },
            "repository_url": { "$ref": "#/$defs/repository_url" },
            "commit_sha": { "$ref": "#/$defs/commit_sha" },
            "checkout_dir": { "$ref": "#/$defs/absolute_path" },
            "work_root": { "$ref": "#/$defs/absolute_path" },
            "output_dir": { "$ref": "#/$defs/absolute_path" },
            "environment": { "$ref": "#/$defs/environment" },
            "release_version": { "type": "string", "minLength": 1, "maxLength": 256 },
            "modules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/module_id" }
            },
            "make_target": { "enum": ["deploy_go_prepare"] },
            "git_credential_lease_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "artifact_upload": { "$ref": "#/$defs/artifact_upload_request" }
          }
        }
      }
    },
    "deployment_release_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "deployment_release" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deployment_id", "target_code", "work_root", "checkout_dir", "artifact_dir", "environment", "release_version", "commit_sha", "modules", "make_target", "timeout_seconds", "cancel_file"],
          "properties": {
            "deployment_id": { "$ref": "#/$defs/id" },
            "target_code": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-zA-Z0-9._-]+$" },
            "work_root": { "$ref": "#/$defs/absolute_path" },
            "checkout_dir": { "$ref": "#/$defs/absolute_path" },
            "artifact_dir": { "$ref": "#/$defs/absolute_path" },
            "environment": { "$ref": "#/$defs/environment" },
            "release_version": { "type": "string", "minLength": 1, "maxLength": 256 },
            "commit_sha": { "$ref": "#/$defs/commit_sha" },
            "modules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/module_id" }
            },
            "make_target": { "enum": ["deploy_go_release"] },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "cancel_file": { "$ref": "#/$defs/absolute_path" },
            "artifact_download": { "$ref": "#/$defs/artifact_download_request" },
            "repository_url": { "$ref": "#/$defs/repository_url" },
            "git_credential_lease_id": { "$ref": "#/$defs/id" },
            "application_slug": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
            "required_env": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/required_env_version" }
            }
          }
        }
      }
    },
    "required_env_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "env_version", "digest", "action"],
      "properties": {
        "file_name": { "type": "string", "minLength": 5, "maxLength": 132, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.env$" },
        "env_version": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/sha256" },
        "action": { "enum": ["write", "delete"] }
      }
    },
    "env_sync_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "env_sync" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["env_sync_id", "application_slug", "file_name", "env_version", "digest", "lease_id", "action"],
          "properties": {
            "env_sync_id": { "$ref": "#/$defs/id" },
            "application_slug": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
            "file_name": { "type": "string", "minLength": 5, "maxLength": 132, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.env$" },
            "env_version": { "type": "integer", "minimum": 1 },
            "digest": { "$ref": "#/$defs/sha256" },
            "lease_id": { "$ref": "#/$defs/id" },
            "action": { "enum": ["write", "delete"] }
          }
        }
      }
    },
    "artifact_upload_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization_id"],
      "properties": { "authorization_id": { "$ref": "#/$defs/id" } }
    },
    "artifact_download_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_run_id", "lease_id", "archive_digest", "manifest_digest"],
      "properties": {
        "target_run_id": { "$ref": "#/$defs/id" },
        "lease_id": { "$ref": "#/$defs/id" },
        "archive_digest": { "$ref": "#/$defs/sha256" },
        "manifest_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "health_diagnose_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "health_diagnose" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checks"],
          "properties": {
            "checks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "enum": ["disk", "work_root", "secrets_root", "clock"] }
            }
          }
        }
      }
    },
    "task_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "task_id", "payload_digest", "disposition", "error_code"],
      "properties": {
        "type": { "const": "task_ack" },
        "task_id": { "$ref": "#/$defs/id" },
        "payload_digest": { "type": "string", "maxLength": 80 },
        "disposition": { "enum": ["accepted", "duplicate", "rejected"] },
        "error_code": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "task_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "task_id", "sequence", "stream", "text"],
      "properties": {
        "type": { "const": "task_output" },
        "task_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "stream": { "enum": ["stdout", "stderr"] },
        "text": { "type": "string", "maxLength": 65536 }
      }
    },
    "task_progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "task_id", "sequence", "event"],
      "properties": {
        "type": { "const": "task_progress" },
        "task_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "event": { "$ref": "#/$defs/deploy_event" }
      }
    },
    "deploy_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploy_id", "stage", "event", "timestamp", "status", "environment", "release_version"],
      "properties": {
        "deploy_id": { "$ref": "#/$defs/id" },
        "stage": { "enum": ["prepare", "release"] },
        "event": {
          "enum": [
            "deploy.started",
            "deploy.finished",
            "deploy.preflight.started",
            "deploy.preflight.succeeded",
            "deploy.preflight.failed",
            "deploy.module.started",
            "deploy.module.succeeded",
            "deploy.module.failed",
            "deploy.step.started",
            "deploy.step.succeeded",
            "deploy.step.failed",
            "deploy.verification.started",
            "deploy.verification.succeeded",
            "deploy.verification.failed"
          ]
        },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "status": { "enum": ["started", "succeeded", "failed"] },
        "environment": { "$ref": "#/$defs/environment" },
        "release_version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "target": { "type": "string", "minLength": 1, "maxLength": 256 },
        "module": { "type": "string", "minLength": 1, "maxLength": 128 },
        "module_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "step_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "step": { "type": "string", "minLength": 1, "maxLength": 512 },
        "message": { "type": "string", "maxLength": 8192 },
        "failure_stage": { "type": "string", "maxLength": 128 },
        "recovery_hint": { "type": "string", "maxLength": 4096 },
        "candidate_release": { "type": "string", "maxLength": 256 },
        "current_release": { "type": "string", "maxLength": 256 },
        "current_switched": { "type": "boolean" }
      }
    },
    "task_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "task_id", "sequence", "state"],
      "properties": {
        "type": { "const": "task_state" },
        "task_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["accepted", "running", "canceling"] }
      }
    },
    "task_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "task_id", "sequence", "status", "exit_code", "error_code", "summary"],
      "properties": {
        "type": { "const": "task_result" },
        "task_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["succeeded", "failed", "canceled", "interrupted"] },
        "exit_code": { "type": ["integer", "null"] },
        "error_code": { "type": ["string", "null"], "maxLength": 128 },
        "summary": { "type": ["string", "null"], "maxLength": 4096 },
        "data": { "type": ["object", "null"], "maxProperties": 32 }
      }
    },
    "task_result_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "sequence", "status", "exit_code", "error_code", "summary"],
      "properties": {
        "task_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["succeeded", "failed", "canceled", "interrupted"] },
        "exit_code": { "type": ["integer", "null"] },
        "error_code": { "type": ["string", "null"], "maxLength": 128 },
        "summary": { "type": ["string", "null"], "maxLength": 4096 },
        "data": { "type": ["object", "null"], "maxProperties": 32 }
      }
    },
    "task_cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "task_id", "reason"],
      "properties": {
        "type": { "const": "task_cancel" },
        "task_id": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "reconcile_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "task_ids"],
      "properties": {
        "type": { "const": "reconcile_request" },
        "task_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "reconcile_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tasks"],
      "properties": {
        "type": { "const": "reconcile_report" },
        "tasks": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/reconciled_task" } }
      }
    },
    "reconciled_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "payload_digest", "state", "last_sequence", "result"],
      "properties": {
        "task_id": { "$ref": "#/$defs/id" },
        "payload_digest": { "type": "string", "maxLength": 80 },
        "state": { "enum": ["accepted", "running", "terminal", "unknown"] },
        "last_sequence": { "type": "integer", "minimum": 0 },
        "result": { "oneOf": [{ "$ref": "#/$defs/task_result_payload" }, { "type": "null" }] }
      }
    },
    "secret_lease_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "task_id", "lease_id", "payload_digest", "purpose"],
      "properties": {
        "type": { "const": "secret_lease_request" },
        "task_id": { "$ref": "#/$defs/id" },
        "lease_id": { "$ref": "#/$defs/id" },
        "payload_digest": { "type": "string", "pattern": "^sha256:[0-9A-Fa-f]+$", "maxLength": 80 },
        "purpose": { "enum": ["git_credential", "application_env"] }
      }
    },
    "secret_lease_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "lease_id", "private_key", "expires_at", "error_code"],
      "properties": {
        "type": { "const": "secret_lease_response" },
        "lease_id": { "$ref": "#/$defs/id" },
        "private_key": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "error_code": { "oneOf": [{ "type": "string", "maxLength": 128 }, { "type": "null" }] }
      }
    },
    "artifact_prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "task_id", "authorization_id", "deployment_id", "manifest_json", "manifest_digest", "total_size", "file_count", "archive_size", "archive_digest"],
      "properties": {
        "type": { "const": "artifact_prepared" },
        "task_id": { "$ref": "#/$defs/id" },
        "authorization_id": { "$ref": "#/$defs/id" },
        "deployment_id": { "$ref": "#/$defs/id" },
        "manifest_json": { "type": "string", "minLength": 2, "maxLength": 1048576 },
        "manifest_digest": { "$ref": "#/$defs/sha256" },
        "total_size": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "file_count": { "type": "integer", "minimum": 1, "maximum": 256 },
        "archive_size": { "type": "integer", "minimum": 1, "maximum": 2147746816 },
        "archive_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact_upload_authorized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "task_id", "authorization_id", "lease_id", "error_code"],
      "properties": {
        "type": { "const": "artifact_upload_authorized" },
        "task_id": { "$ref": "#/$defs/id" },
        "authorization_id": { "$ref": "#/$defs/id" },
        "lease_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "error_code": { "oneOf": [{ "type": "string", "maxLength": 128 }, { "type": "null" }] }
      }
    },
    "terminal_open": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id", "sequence", "columns", "rows", "connection_generation", "capability"],
      "properties": {
        "type": { "const": "terminal_open" },
        "session_id": { "$ref": "#/$defs/id" },
        "sequence": { "const": 0 },
        "columns": { "$ref": "#/$defs/terminal_columns" },
        "rows": { "$ref": "#/$defs/terminal_rows" },
        "connection_generation": { "type": "integer", "minimum": 1 },
        "capability": { "type": "string", "minLength": 32, "maxLength": 4096 }
      }
    },
    "terminal_opened": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id", "sequence"],
      "properties": {
        "type": { "const": "terminal_opened" },
        "session_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 }
      }
    },
    "terminal_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id", "sequence", "encoding", "data"],
      "properties": {
        "type": { "const": "terminal_input" },
        "session_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "encoding": { "const": "base64" },
        "data": { "$ref": "#/$defs/terminal_frame" }
      }
    },
    "terminal_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id", "sequence", "encoding", "data"],
      "properties": {
        "type": { "const": "terminal_output" },
        "session_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "encoding": { "const": "base64" },
        "data": { "$ref": "#/$defs/terminal_frame" }
      }
    },
    "terminal_resize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id", "sequence", "columns", "rows"],
      "properties": {
        "type": { "const": "terminal_resize" },
        "session_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "columns": { "$ref": "#/$defs/terminal_columns" },
        "rows": { "$ref": "#/$defs/terminal_rows" }
      }
    },
    "terminal_close": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id", "sequence", "reason"],
      "properties": {
        "type": { "const": "terminal_close" },
        "session_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "reason": { "enum": ["administrator_request", "browser_disconnected", "authorization_revoked", "idle_timeout", "lifetime_exceeded", "protocol_error"] }
      }
    },
    "terminal_exited": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id", "sequence", "reason", "exit_code"],
      "properties": {
        "type": { "const": "terminal_exited" },
        "session_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "reason": { "enum": ["process_exited", "administrator_request", "peer_disconnected", "authorization_revoked", "idle_timeout", "lifetime_exceeded", "output_limit_exceeded", "protocol_error", "executor_unavailable"] },
        "exit_code": { "type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647 }
      }
    },
    "protocol_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code", "message", "related_message_id", "details"],
      "properties": {
        "type": { "const": "protocol_error" },
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "maxLength": 1024 },
        "related_message_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "details": { "type": ["object", "null"] }
      }
    },
    "absolute_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\u0000-\\u001F]*$"
    },
    "terminal_columns": { "type": "integer", "minimum": 1, "maximum": 500 },
    "terminal_rows": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "terminal_frame": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
