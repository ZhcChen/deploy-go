# 用途: 提供 PostgreSQL 初始化数据库、用户、密码、数据目录和时区。
# 推荐调整: 部署前必须修改数据库名、用户名和密码；PGDATA 仅在确认卷布局后调整。
# 默认关系: 健康检查读取 POSTGRES_DB/POSTGRES_USER；PGDATA 位于 compose.yaml 的持久化卷内。
# 安全边界: POSTGRES_PASSWORD=change-me 不可部署，文件必须由 Deploy Go 加密保存且不得提交仓库。
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
PGDATA=/var/lib/postgresql/data
TZ=Asia/Shanghai
